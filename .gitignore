# Only include the backend and frontend in the combined repository
/*
!/soho-backend/
!/soho-frontend/
!/.gitignore

# Dependencies
node_modules/

# Build output and caches
dist/
build/
coverage/
.angular/cache/
.nest/
.cache/
.tmp/
.temp/
tmp/
*.tsbuildinfo

# Local environment variables (keep examples)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/
*.sublime-workspace

# Local review and design-tool state
.checkout-review/
.impeccable/
.taste-skill/
.revision/
