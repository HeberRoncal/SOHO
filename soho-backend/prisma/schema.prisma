  usuario             Usuario?              @relation("PropietarioInstruccionPago", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pedido              Pedido?               @relation("PedidoDeInstruccion", fields: [pedidoId, claveCreacionPedido], references: [id, claveCreacion], onDelete: Restrict, onUpdate: Restrict)
  pago                PagoPedido?           @relation("PagoDeInstruccion")
  recepcionCompra     RecepcionCompra?      @relation("InstruccionDeRecepcion")
