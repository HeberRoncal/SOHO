  creadoEn                  DateTime                           @default(now()) @map("creado_en") @db.DateTime(3)
  actualizadoEn             DateTime                           @default(now()) @updatedAt @map("actualizado_en") @db.DateTime(3)
  finalizadoEn              DateTime?                          @map("finalizado_en") @db.DateTime(3)
  recepcion                 RecepcionCompra                    @relation(fields: [recepcionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comprobante               ComprobanteRecepcionCompra         @relation("ComprobanteDeOperacionRecepcion", fields: [comprobanteId, recepcionId], references: [id, recepcionId], onDelete: Restrict, onUpdate: Restrict)
  contenidoCopia            ComprobanteRecepcionCompra?        @relation("ContenidoCopiaRecepcion", fields: [comprobanteId, recepcionId, archivoPedidoSha256, archivoPedidoFormato, archivoPedidoBytes], references: [id, recepcionId, archivoSha256, formato, tamanoBytes], onDelete: Restrict, onUpdate: Restrict)
  responsable               Usuario?                           @relation("ResponsableOperacionRecepcion", fields: [responsableId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recepcionId, creadoEn, id], map: "operaciones_recepcion_historial_idx")
  @@index([comprobanteId, recepcionId], map: "operaciones_recepcion_comprobante_idx")
  @@index([comprobanteId, recepcionId, archivoPedidoSha256, archivoPedidoFormato, archivoPedidoBytes], map: "operaciones_recepcion_copia_idx")
  @@index([responsableId, creadoEn, id], map: "operaciones_recepcion_responsable_idx")
  @@index([estado, proximaRevisionEn, bloqueoProcesoHasta], map: "operaciones_recepcion_revision_idx")
  @@map("operaciones_recepcion_compra")
}
