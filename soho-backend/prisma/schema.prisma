  archivoClave          String                            @unique @map("archivo_clave") @db.VarChar(255)
  archivoSha256Original String                            @map("archivo_sha256_original") @db.Char(64)
  archivoSha256         String                            @map("archivo_sha256") @db.Char(64)
  nombreArchivo         String                            @map("nombre_archivo") @db.VarChar(255)
  formato               String                            @db.VarChar(32)
  tamanoBytes           Int                               @map("tamano_bytes") @db.UnsignedInt
  numeroOperacion       String?                           @map("numero_operacion") @db.VarChar(12)
  estadoArchivo         EstadoArchivoComprobanteRecepcion @default(PENDIENTE) @map("estado_archivo")
  tokenEscritura        String?                           @map("token_escritura") @db.Char(36)
  bloqueoEscrituraHasta DateTime?                         @map("bloqueo_escritura_hasta") @db.DateTime(3)
  intentosEscritura     Int                               @default(0) @map("intentos_escritura") @db.UnsignedInt
  proximaRevisionEn     DateTime?                         @map("proxima_revision_en") @db.DateTime(3)
  ultimaIncidencia      String?                           @map("ultima_incidencia") @db.VarChar(300)
  confirmadoEn          DateTime?                         @map("confirmado_en") @db.DateTime(3)
  pagoDestinoId         String?                           @unique(map: "comprobantes_recepcion_pago_destino_key") @map("pago_destino_id") @db.Char(36)
  creadoEn              DateTime                          @default(now()) @map("creado_en") @db.DateTime(3)
  actualizadoEn         DateTime                          @default(now()) @updatedAt @map("actualizado_en") @db.DateTime(3)
  recepcion             RecepcionCompra                   @relation("ComprobantesDeRecepcion", fields: [recepcionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actualEn              RecepcionCompra?                  @relation("ComprobanteActualRecepcion")
  destino               RecepcionCompra?                  @relation("DestinoComprobanteRecepcion", fields: [recepcionId, pagoDestinoId], references: [id, pagoId], onDelete: Restrict, onUpdate: Restrict)
  origenEnPago          ComprobantePago?                  @relation("OrigenComprobantePago")
  operaciones           OperacionRecepcionCompra[]        @relation("ComprobanteDeOperacionRecepcion")
  copias                OperacionRecepcionCompra[]        @relation("ContenidoCopiaRecepcion")

  @@unique([recepcionId, version], map: "comprobantes_recepcion_version_key")
  @@unique([id, recepcionId], map: "comprobantes_recepcion_id_recepcion_key")
  @@unique([id, recepcionId, estadoArchivo], map: "comprobantes_recepcion_disponible_key")
  @@unique([recepcionId, pagoDestinoId], map: "comprobantes_recepcion_destino_key")
  @@unique([id, pagoDestinoId, archivoSha256, formato, tamanoBytes], map: "comprobantes_recepcion_pago_contenido_key")
  @@unique([id, recepcionId, archivoSha256, formato, tamanoBytes], map: "comprobantes_recepcion_copia_contenido_key")
  @@index([estadoArchivo, proximaRevisionEn, bloqueoEscrituraHasta], map: "comprobantes_recepcion_revision_idx")
  @@map("comprobantes_recepcion_compra")
}

