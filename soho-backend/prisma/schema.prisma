  @@unique([pedidoId, claveCreacionPedido], map: "instrucciones_pedido_clave_key")
  @@unique([id, pedidoId, metodo], map: "instrucciones_id_pedido_metodo_key")
  @@index([metodoConfiguradoId, metodo])
  @@index([usuarioId, emitidaEn, id])
  @@index([accesoInvitadoHash, emitidaEn, id], map: "instrucciones_invitado_fecha_idx")
  @@index([claveCreacionPedido, emitidaEn, id], map: "instrucciones_checkout_fecha_idx")
