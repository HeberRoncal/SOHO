enum EstadoRecepcionCompra {
  RECIBIENDO
  RECIBIDA
  REQUIERE_ATENCION
  PEDIDO_CREADO
}

enum EstadoArchivoComprobanteRecepcion {
  PENDIENTE
  DISPONIBLE
}

enum AccionRecepcionCompra {
  PROCESAR
  REGISTRAR_PEDIDO
  SOLICITAR_CORRECCION
  ADJUNTAR_COMPROBANTE
}

enum EstadoOperacionRecepcionCompra {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
}

/// Recepción anterior al pedido. El propietario se obtiene de la instrucción.
/// El servicio confirmará el archivo antes de anunciar RECIBIDA y conservará su evidencia.
model RecepcionCompra {
  id                      String                            @id @default(uuid()) @db.Char(36)
  referencia              String                            @unique @db.VarChar(24)
  instruccionId           String                            @unique(map: "recepciones_instruccion_key") @map("instruccion_id") @db.Char(36)
  claveCreacionPedido     String                            @unique(map: "recepciones_checkout_key") @map("clave_creacion_pedido") @db.Char(36)
  claveSolicitud          String                            @unique @map("clave_solicitud") @db.Char(36)
  solicitudHash           String                            @map("solicitud_hash") @db.Char(64)
  version                 Int                               @default(1) @db.UnsignedInt
  estado                  EstadoRecepcionCompra             @default(RECIBIENDO)
  motivos                 Json
  respuesta               Json?
  accesoInvitadoExpiraEn  DateTime?                         @map("acceso_invitado_expira_en") @db.DateTime(3)
  comprobanteActualId     String?                           @unique(map: "recepciones_comprobante_actual_key") @map("comprobante_actual_id") @db.Char(36)
  /// Constante SQL; el FK solo admite un archivo DISPONIBLE de esta misma recepción.
  estadoComprobanteActual EstadoArchivoComprobanteRecepcion @default(DISPONIBLE) @map("estado_comprobante_actual")
  pedidoId                String?                           @unique(map: "recepciones_pedido_key") @map("pedido_id") @db.Char(36)
  pagoId                  String?                           @unique(map: "recepciones_pago_key") @map("pago_id") @db.Char(36)
  creadoEn                DateTime                          @default(now()) @map("creado_en") @db.DateTime(3)
  actualizadoEn           DateTime                          @default(now()) @updatedAt @map("actualizado_en") @db.DateTime(3)
  recibidaEn              DateTime?                         @map("recibida_en") @db.DateTime(3)
  pedidoRegistradoEn      DateTime?                         @map("pedido_registrado_en") @db.DateTime(3)
  instruccion             InstruccionPago                   @relation("InstruccionDeRecepcion", fields: [instruccionId, claveCreacionPedido], references: [id, claveCreacionPedido], onDelete: Restrict, onUpdate: Restrict)
  instruccionVinculada    InstruccionPago?                  @relation("InstruccionVinculadaRecepcion", fields: [instruccionId, pedidoId], references: [id, pedidoId], onDelete: Restrict, onUpdate: Restrict)
  pedido                  Pedido?                           @relation("PedidoDeRecepcion", fields: [pedidoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pago                    PagoPedido?                       @relation("PagoDeRecepcion", fields: [pagoId, pedidoId, instruccionId], references: [id, pedidoId, instruccionId], onDelete: Restrict, onUpdate: Restrict)
  comprobanteActual       ComprobanteRecepcionCompra?       @relation("ComprobanteActualRecepcion", fields: [comprobanteActualId, id, estadoComprobanteActual], references: [id, recepcionId, estadoArchivo], onDelete: Restrict, onUpdate: Restrict)
  comprobantes            ComprobanteRecepcionCompra[]      @relation("ComprobantesDeRecepcion")
  comprobanteDestino      ComprobanteRecepcionCompra?       @relation("DestinoComprobanteRecepcion")
  operaciones             OperacionRecepcionCompra[]

  @@unique([instruccionId, claveCreacionPedido], map: "recepciones_instruccion_checkout_key")
  @@unique([instruccionId, pedidoId], map: "recepciones_instruccion_pedido_key")
  @@unique([pagoId, pedidoId, instruccionId], map: "recepciones_pago_pedido_instruccion_key")
  @@unique([comprobanteActualId, id, estadoComprobanteActual], map: "recepciones_actual_disponible_key")
  @@unique([id, pagoId], map: "recepciones_id_pago_key")
  @@index([estado, creadoEn, id], map: "recepciones_bandeja_idx")
  @@index([accesoInvitadoExpiraEn], map: "recepciones_acceso_idx")
  @@map("recepciones_compra")
}

