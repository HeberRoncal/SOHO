# Ejemplo local: reemplazar usuario, contraseña y nombre de la base antes de conectarse.
# Codificar los caracteres especiales del usuario y la contraseña para una URL.
DATABASE_URL="mysql://USUARIO:CONTRASENA@127.0.0.1:3306/soho_db"

# Orígenes exactos del frontend, sin barra final. En producción deben usar HTTPS.
AUTH_ORIGENES="http://localhost:4200,http://127.0.0.1:4200"
# En desarrollo puede omitirse: se genera un secreto por proceso.
# En producción es obligatorio un secreto aleatorio de al menos 32 bytes.
# Generar: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRETO_CSRF="REEMPLAZAR_CON_EL_SECRETO_GENERADO"

# ID público del cliente web de Google. Vacío desactiva Google sin afectar contraseña.
GOOGLE_CLIENT_ID=""

# Almacenamiento persistente privado de comprobantes. Nunca servir como carpeta pública.
# PEDIDOS_DIRECTORIO_PRIVADO="C:/datos-soho/privado"
# Sin configurar se utiliza soho-backend/.privado.

# Recuperación de contraseña. Sin SMTP_HOST el envío permanece deshabilitado.
# Copiar y completar el bloque para conectar un proveedor SMTP real.
# RECUPERACION_ORIGEN="http://localhost:4200"
# SMTP_HOST="smtp.proveedor.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USUARIO="usuario-del-proveedor"
# SMTP_CLAVE="credencial-privada-del-proveedor"
# SMTP_REMITENTE="cuentas@tu-dominio.com"
# El puerto 587 exige STARTTLS; 465 requiere SMTP_SECURE=true.
# Solo para un capturador SMTP local, nunca para enviar correo real:
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="1025"
# SMTP_REMITENTE="cuentas@soho.test"
# SMTP_PERMITIR_INSEGURO_LOCAL="true"

# Cloudinary: fotografías de productos (integración pendiente)
# Completar solo en .env con los valores de tu cuenta; API Secret solo en el backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set false to stop automatic photo reconciliation and cleanup.
CLOUDINARY_PROCESADOR_ACTIVO=true

# Emisión de instrucciones: mantener false hasta completar recepción, atención y Angular.
PAGOS_CHECKOUT_ACTIVO=false
