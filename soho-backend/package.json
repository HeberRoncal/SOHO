{
  "name": "soho-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:check": "tsx scripts/comprobar-bd.ts",
    "db:productos:plan": "node --env-file=.env --import tsx scripts/planificar-productos.ts",
    "db:productos:convertir": "node --env-file=.env --import tsx scripts/convertir-productos.ts",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate:deploy": "prisma migrate deploy",
    "admin:crear": "tsx scripts/crear-admin.ts",
    "prebuild": "prisma generate",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ prisma/ scripts/ prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:db": "vitest run --config ./vitest.config.db.ts",
    "test:carrito": "vitest run --config ./vitest.config.carrito.ts",
    "test:conversion": "vitest run --config ./vitest.config.conversion.ts",
    "test:borradores": "vitest run --config ./vitest.config.borradores.ts",
    "test:fotografias": "vitest run --config ./vitest.config.fotografias.ts",
    "test:publicacion": "vitest run --config ./vitest.config.publicacion.ts",
    "test:movimientos": "vitest run --config ./vitest.config.movimientos.ts",
    "test:archivo": "vitest run --config ./vitest.config.archivo.ts",
    "test:publicados": "vitest run --config ./vitest.config.publicados.ts",
    "test:clientes": "vitest run --config ./vitest.config.clientes.ts",
    "test:configuracion-pagos": "vitest run --config ./vitest.config.configuracion-pagos.ts",
    "test:instrucciones": "vitest run --config ./vitest.config.instrucciones.ts",
    "test:recepciones": "vitest run --config ./vitest.config.recepciones.ts",
    "test:procesamiento": "vitest run --config ./vitest.config.procesamiento.ts",
    "test:atencion": "vitest run --config ./vitest.config.atencion.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "8.8.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "cloudinary": "2.11.0",
    "dotenv": "17.4.2",
    "google-auth-library": "11.3.4",
    "nodemailer": "10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
